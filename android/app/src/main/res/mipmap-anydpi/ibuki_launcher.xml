<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7.x fallback. Reuse the original artwork without changing pixels. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="48dp" android:height="48dp" android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="@color/launcher_icon_background" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:width="44dp" android:height="44dp" android:gravity="center">
        <bitmap
            android:src="@drawable/launcher_world"
            android:gravity="fill"
            android:filter="true" />
    </item>
</layer-list>
